# Telegram bot credentials (server-only — never expose to the browser, never use NEXT_PUBLIC_)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional path to the JSON lead store (defaults to <cwd>/data/leads.json)
# LEADS_STORE_PATH=/app/data/leads.json

# Optional path for discount popup dismiss tracking by IP (defaults to <cwd>/data/discount-visitors.json)
# DISCOUNT_STORE_PATH=/app/data/discount-visitors.json
