# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets (keep .env.example)
.env
.env.local
.env.production
.env.development
.env*.local
.env*
!.env.example

# deployment runtime secrets (server-side only)
deploy/.secrets/
deploy/*.secret
*.key

# vercel
.vercel

# persisted lead store (local / Docker bind mount)
/data/

# typescript
*.tsbuildinfo
next-env.d.ts
